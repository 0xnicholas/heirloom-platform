{
  "name": "@heirloom/dsl",
  "version": "1.0.0",
  "description": "Heirloom ontology DSL — objectType/structType/link/action/queryFn builders, registry, definition JSON materialization (spec 10/20/60)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@heirloom/example-ontology": "workspace:*"
  }
}
