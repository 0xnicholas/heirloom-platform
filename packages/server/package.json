{
  "name": "@heirloom/server",
  "version": "0.1.0",
  "description": "Heirloom REST server — semantic + admin surfaces on Fastify (spec 30)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.js",
  "bin": {
    "heirloom-server": "./dist/start.js"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @heirloom/engine build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/start.js"
  },
  "dependencies": {
    "@heirloom/engine": "workspace:*",
    "fastify": "^5.6.1",
    "kysely": "^0.28.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@heirloom/cli": "workspace:*",
    "@heirloom/dsl": "workspace:*",
    "@heirloom/example-ontology": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
